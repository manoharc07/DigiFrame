# local copy of config.h with real credentials
config.h.local-backup

# local test builds with real credentials baked in — never commit
build-local/

# build output — produced locally and published by the release workflow
# (.github/workflows/release.yml), so it's never committed
build/

# local Claude Code settings
.claude/settings.local.json

# dev tooling output — screenshots/films of the panel and dashboard
dev/shots/

# python bytecode from dev/ and tests/
__pycache__/
*.py[cod]
